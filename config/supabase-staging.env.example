# BizOn Supabase staging template
# Copy values into the protected GitHub Environment named: supabase-staging
# DO NOT rename this file to .env and DO NOT commit real secrets.

# Environment variables (not secret)
SUPABASE_STAGING_PROJECT_REF=replace-with-staging-project-ref
SUPABASE_STAGING_URL=https://replace-with-staging-project-ref.supabase.co

# Environment secrets
SUPABASE_STAGING_DATABASE_URL=postgresql://postgres.replace-with-staging-project-ref:REPLACE_DATABASE_PASSWORD@REPLACE_DATABASE_HOST:5432/postgres?sslmode=require
SUPABASE_STAGING_ANON_KEY=REPLACE_WITH_STAGING_ANON_KEY
SUPABASE_STAGING_INSTRUCTOR_KEY=REPLACE_WITH_UNIQUE_STAGING_INSTRUCTOR_KEY

# Workflow inputs entered manually when running BizOn Supabase Staging Gate
CONFIRM_PROJECT_REF=replace-with-staging-project-ref
APPLY_MIGRATION=false
RUN_RETENTION_PURGE=true
