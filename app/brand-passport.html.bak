<!doctype html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#07141f">
  <meta name="description" content="Brand Passport trong BizOn: mô phỏng quyết định quốc tế hóa doanh nghiệp và phản tư sau lựa chọn.">
  <title>Brand Passport | BizOn</title>
  <link rel="manifest" href="./manifest.webmanifest">
  <link rel="icon" href="../assets/icons/icon-192.png">
  <style>
    *{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;background:#07141f;color:#fff;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;overflow:hidden}
    .bar{height:56px;display:flex;align-items:center;gap:12px;padding:0 14px;background:#07141f;border-bottom:1px solid rgba(255,255,255,.12)}
    .bar a{color:#fff;text-decoration:none;font-weight:800}.bar strong{font-size:.92rem}.bar span{margin-left:auto;padding:6px 9px;border-radius:999px;background:rgba(56,198,223,.13);color:#77d8e8;font-size:.68rem;font-weight:800}
    iframe{display:block;width:100%;height:calc(100% - 56px);border:0;background:#eef5f8}
  </style>
</head>
<body>
  <header class="bar"><a href="./release.html" aria-label="Về trang chủ BizOn">← BizOn</a><strong>Brand Passport</strong><span>Lưu trên thiết bị</span></header>
  <iframe src="../brand-passport-learning.html" title="Brand Passport" allow="clipboard-write"></iframe>
</body>
</html>
